{
  "name": "task-board",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader runner",
    "build": "vue-tsc -b && vite build --configLoader runner",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
